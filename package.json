{
  "dependencies": {},
  "name": "simlife-hearthbyte-edition",
  "productName": "SimLife: Hearthbyte Edition",
  "version": "2.0.0",
  "description": "A cozy offline-first browser and Electron life simulation with isometric home building, autonomous characters, careers, relationships, and migration-safe local saves.",
  "main": "main.js",
  "scripts": {
    "test": "npm run test:pure && npm run test:electron",
    "test:pure": "node scripts/verify-game.js --scope=pure",
    "test:electron": "node scripts/verify-game.js --scope=electron",
    "test:visual": "node scripts/capture-visuals.js",
    "generate:avatars": "node scripts/generate-avatar-assets.js",
    "generate:world": "node scripts/generate-world-assets.js",
    "generate:world:extract": "python scripts/extract-furniture-sheet.py",
    "start:desktop": "electron .",
    "build:win": "electron-builder --win",
    "sop:doctor": "web-sop doctor",
    "sop:check": "web-sop check --mode fast",
    "sop:release": "web-sop check --mode release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverlion2/simlife.git"
  },
  "keywords": [
    "life-simulation",
    "retro-game",
    "pixel-art",
    "electron"
  ],
  "author": "SimLife Team",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/silverlion2/simlife/issues"
  },
  "homepage": "https://github.com/silverlion2/simlife#readme",
  "build": {
    "appId": "com.simlife.hearthbyte",
    "productName": "SimLife Hearthbyte Edition",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "css/**/*",
      "js/**/*",
      "!js/renderer_utf8.js",
      "vendor/**/*",
      "assets/**/*",
      "!assets/**/*.zip",
      "!assets/**/Samples/**/*",
      "!assets/**/Sample.png",
      "!assets/**/Preview.png",
      "!assets/**/*.url",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SimLife-Hearthbyte-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "easystarjs": "^0.4.4",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "navmesh": "^2.3.1",
    "phaser": "^4.0.0",
    "phaser4-rex-plugins": "^4.2.0",
    "playwright": "^1.59.1",
    "steamworks.js": "^0.4.0"
  }
}
